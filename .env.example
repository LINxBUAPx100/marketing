# Sin DATABASE_URL se usa PGlite en ./.data/pglite (solo desarrollo).
# En producción, la cadena de conexión de Supabase (modo "transaction pooler"):
# DATABASE_URL=postgres://usuario:password@host:6543/postgres

# Facturación CFDI 4.0 con Facturapi (https://www.facturapi.io). Sin llave, las facturas se simulan sin validez fiscal.
# sk_test_… = ambiente de pruebas del SAT; sk_live_… = facturas reales. El CSD se sube en el panel de Facturapi.
# FACTURAPI_KEY=sk_test_xxxxxxxxxxxxxxxx

# WhatsApp Cloud API (Meta). Sin estas variables los botones abren wa.me y los avisos automáticos se simulan.
# Se obtienen en developers.facebook.com › tu app › WhatsApp › Configuración de la API (usa un token permanente de usuario del sistema).
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=123456789012345
# WHATSAPP_IDIOMA=es_MX
